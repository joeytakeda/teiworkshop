        <moduleRef n="22" key="tagdocs"/>
        <moduleRef n="23" key="wea"/>
        
        <elementSpec ident="slugline" module="wea" ns="https://winnifredeatonarchive.org/ns">
          <classes>
            <memberOf key="att.global"/>
            <memberOf key="model.labelLike"/>
          </classes>
          <content>
